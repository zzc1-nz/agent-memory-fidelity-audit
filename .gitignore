# .gitignore - keep credentials, caches and run artifacts out of version control.

# LLM credential obtained out-of-band (short-lived, machine-local)
.cache/
# Machine-local helpers that must not be published (see local/README.md).
local/refresh_trae.py
# Test fixtures stage their scratch dirs inside the project, because the system temp
# directory is not writable under the sandbox this repo was developed in.
.pytmp/
pytest_tmp/
__pycache__/
*.pyc
.pytest_cache/
piptmp/
.tmp/
# Interpreter/build artifacts created while verifying Python 3.10 compatibility
pip_chk/
.uvcache/
.uvpython/
.venv*/

# Vendored third-party code (re-created by scripts/bootstrap.py)
vendor/tiktoken/
vendor/pytest/

# Experiment outputs are regenerated by `python -m memfaith.run`. The published
# subset under results/ is force-added (see results/README.md) so the headline
# numbers and charts in the README are reproducible from, not merely asserted by,
# the committed data.
data/
results/answers.jsonl
results/compressions.jsonl
results/run_full.log
results/eval_summary.json
results/*.json.tmp
